#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [[ -f "$ROOT/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$ROOT/.env"
  set +a
fi

if ! command -v go >/dev/null 2>&1; then
  if [[ -x "$HOME/.local/go/bin/go" ]]; then
    export PATH="$HOME/.local/go/bin:$PATH"
  else
    echo "go not found on PATH (also checked ~/.local/go/bin)" >&2
    exit 1
  fi
fi

echo "Depop Store Manager → http://127.0.0.1:8787"
exec go run ./cmd/server -root "$ROOT"
