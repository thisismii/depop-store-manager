# Shop identity (required for labeled Sync / Refresh UI; leave blank for fixture demo).
# Set the same keys as Cursor Cloud Agent / environment secrets — never commit .env.
DEPOP_SHOP_ID=
DEPOP_SHOP_USERNAME=

# Optional — used by POST /api/rewrite when set.
# Without these, the server uses the built-in heuristic rewriter (demo-safe).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
